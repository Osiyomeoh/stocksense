# Copy to .env and fill in. .env is gitignored; never commit or paste secrets.

# true: replay data/sample_cache/ with Zetaris and Nightshift stopped
SAMPLE_MODE=true

# Zetaris REST. Local install: http://localhost:8888/api/v1.0. Zetaris Cloud:
# the gateway UI's proxy, https://<gateway-host>/api/proxy, which accepts the
# API key. Key: Zetaris UI, Management -> API Tokens.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
CLINIC_RISK_TABLE=lightning.metastore.stocksense.k2_usl.clinic_risk

# Nightshift, the primary AI provider (OpenAI-compatible)
NIGHTSHIFT_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_MODEL=meterless/auto

# K2 seed only (killtests/k2/load_pg.py)
STOCKSENSE_PG_HOST=
STOCKSENSE_PG_PORT=5432
STOCKSENSE_PG_DB=stocksense
STOCKSENSE_PG_USER=
STOCKSENSE_PG_PASSWORD=
STOCKSENSE_PG_ZETARIS_PASSWORD=
